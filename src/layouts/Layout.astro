---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A small Astro project used to try out the pull request workflow.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Inicio</a>
        <a href="/acerca">Acerca de</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© {new Date().getFullYear()} Prueba Asisteme</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-fondo: #ffffff;
    --color-texto: #1f2937;
    --color-acento: #6d28d9;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --color-fondo: #111827;
      --color-texto: #e5e7eb;
      --color-acento: #a78bfa;
    }
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: var(--color-fondo);
    color: var(--color-texto);
  }
  nav {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }
  a {
    color: var(--color-acento);
  }
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }
  footer {
    text-align: center;
    padding: 2rem 1rem;
    opacity: 0.7;
  }
</style>
